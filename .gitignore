# macOS
.DS_Store

# Secrets. Never commit keys.
.env

# Generated world data. Recreate with: uv run python -m seed.generate
data/cartwheel.db

# Local conversation state and scenario/replay run outputs.
.sessions.db
scenarios/results/
replay/results/
.harbor/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
scenarios/demo_pilot_gt.json

# Review app cache (a local copy of Langfuse traces; Langfuse stays canonical).
analysis/review_app/.cache/

# SQLite write-ahead files next to the local conversation state.
.sessions.db-shm
.sessions.db-wal
