    "b2_intent": {
      "selected_at": "2026-11-01T17:57:03.249222+00:00",
      "method": "stratified by scenario tuple.intent over pool minus batch 1; 2 per intent + 1 for the 6 largest intents (cancellation, order_status, policy_question, product_search, refund, return_deadline); random.Random(5).sample within each stratum, strata in name order"
    },
    "b3_depth": {
      "selected_at": "2026-11-01T20:38:56.447096+00:00",
      "method": "purposive depth searches on pre-reading metadata (scenario tuple, data-quality case, tools called); searches run in order without replacement, random.Random(6) within each; not used for prevalence",
      "searches": [
        {
          "name": "dq_store_mismatch",
          "target_mode": "unverified_order_match",
          "rule": "data-quality case dq-order-store-mismatch",
          "n": 2
        },
        {
          "name": "ambiguous",
          "target_mode": "unverified_order_match",
          "rule": "difficulty=ambiguous",
          "n": 2
        },
        {
          "name": "dq_missing_title",
          "target_mode": "unverified_product_identity / search_query_misuse",
          "rule": "dq-product-missing-title",
          "n": 2
        },
        {
          "name": "dq_duplicate_title",
          "target_mode": "unverified_product_identity / search_query_misuse",
          "rule": "dq-product-duplicate-title",
          "n": 1
        },
        {
          "name": "dq_invalid_price",
          "target_mode": "unverified_product_identity / search_query_misuse",
          "rule": "dq-product-invalid-price",
          "n": 1
        },
        {
          "name": "above_threshold",
          "target_mode": "redundant_escalation",
          "rule": "record_state=order_above_threshold",
          "n": 3
        },
        {
          "name": "restocking_fee",
          "target_mode": "refund_options_mismatch_policy",
          "rule": "applicable_policy in store-cascade-audio-policy, store-second-stitch-apparel-policy, cw-restocking-fees",
          "n": 3
        },
        {
          "name": "account_store_scope",
          "target_mode": "ungrounded_claim",
          "rule": "intent in account_change, store_info, out_of_scope",
          "n": 3
        },
        {
          "name": "shopper_order_lookup",
          "target_mode": "asks_instead_of_looking_up / answer_is_too_technical",
          "rule": "role=shopper and find_order or list_my_orders called",
          "n": 3
        },
        {
          "name": "late_write",
          "target_mode": "write_without_confirmation (close negatives)",
          "rule": "multi-turn, a write tool only in turn 2 or later",
          "n": 3
        },
        {
          "name": "dq_dates",
          "target_mode": "wrong_world_date",
          "rule": "dq-order-reversed-dates or dq-order-missing-delivery-date",
          "n": 2
        }
      ]
    },
    "b4_random": {
      "selected_at": "2026-11-08T18:54:17.732391+00:00",
      "method": "random.Random(7).sample(sorted pool minus batches 1-3, 15); drawn after the taxonomy draft to check saturation"
    },
    "d_search": {
      "selected_at": "2026-11-08T20:06:49.623524+00:00",
      "method": "Part D searches over the 151 unreviewed pool sessions with deterministic filters on tool results (retrieval signal, not a label); every hit added; not used for sample fractions",
      "searches": [
        {
          "name": "order_match",
          "target_mode": "unverified_order_match",
          "rule": "Part D search for unverified_order_match: shopper, no order number in the message, list_my_orders returns >=2 orders from one store",
          "n": 9
        },
        {
          "name": "query_zero_hits",
          "target_mode": "search_query_misuse",
          "rule": "Part D search for search_query_misuse: search_products returned 0 results for a query of 2+ words",
          "n": 4
        },
        {
          "name": "not_available_claim",
          "target_mode": "search_query_misuse (revised definition)",
          "rule": "Part D repeat search for search_query_misuse (revised definition): search_products called and the reply contains a not-found phrase (not seeing/finding, couldn't/didn't find, no matching, don't see any, not available); pool = 138 unreviewed sessions; 1 hit",
          "n": 1
        }
      ]
    }
  },
